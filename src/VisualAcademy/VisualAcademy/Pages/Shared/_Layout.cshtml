@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - VisualAcademy</title>
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.mvc.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/VisualAcademy.styles.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/azunt-core.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/azunt-landing.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/azunt-visualacademy.css" asp-append-version="true" />
  <script src="https://cdn.jsdelivr.net/npm/azunt@1.1.1/src/azunt.js"></script>
  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="az-public-body" data-az-shell="landing" data-az-shell-mode="mvc-razor">
  @await Html.PartialAsync("~/Views/Shared/_AzPublicHeader.cshtml")
  <main class="az-va-public-main" id="az-public-main">@RenderBody()</main>
  @await Html.PartialAsync("~/Views/Shared/_AzPublicFooter.cshtml")
  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  <script src="~/js/site.mvc.js" asp-append-version="true"></script>
  <script src="~/js/azunt-landing.js" asp-append-version="true"></script>
  <script src="/_framework/blazor.server.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
