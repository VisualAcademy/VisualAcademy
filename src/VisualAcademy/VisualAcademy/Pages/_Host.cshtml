@page "/dashboard"
@using Microsoft.AspNetCore.Components.Web
@using VisualAcademy.Models.AzuntDashboard
@namespace VisualAcademy.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var dashboardNavigation = DashboardNavigationCatalog.Build(HttpContext.Request.Path.Value);
}
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard - VisualAcademy</title>
  <base href="~/" />
  <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.blazor.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/VisualAcademy.styles.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/azunt-core.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/azunt-dashboard.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/azunt-visualacademy.css" asp-append-version="true" />
  <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body class="az-dashboard-body" data-az-shell="dashboard" data-az-shell-mode="blazor-server">
  <header class="az-portal-topbar">
    <button id="appLauncherToggle"
            class="az-portal-app-launcher"
            type="button"
            aria-label="Open VisualAcademy apps"
            aria-controls="appLauncherMenu"
            aria-expanded="false"
            title="Apps">
      <span class="az-portal-waffle" aria-hidden="true">
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
      </span>
    </button>
    <a class="az-portal-brand" href="/dashboard"><span class="az-brand-mark az-small">V</span><span>VisualAcademy Portal</span></a>
    <button id="sidebarToggle" class="az-portal-hamburger" type="button" aria-label="Hide navigation" title="Hide navigation" aria-expanded="true">
      <span></span><span></span><span></span>
    </button>
    <nav class="az-portal-shortcuts" aria-label="Portal shortcuts">
      <a href="/dashboard">⌂ Dashboard</a>
      <a href="/Articles">＋ Articles</a>
      <a href="/aspnetcore-roadmap/index.html">Roadmap</a>
    </nav>
    <div class="az-portal-actions">
      <a href="/">Public site</a>
      <a class="az-avatar" href="/Identity/Account/Manage">@((User.Identity?.Name ?? "U")[0].ToString().ToUpperInvariant())</a>
    </div>
  </header>

  <section id="appLauncherMenu" class="az-portal-app-menu" aria-hidden="true" aria-label="Azunt apps">
    <div class="az-portal-app-menu-header">
      <div>
        <strong>VisualAcademy</strong>
        <span>Sites and tools</span>
      </div>
      <a href="/">Home</a>
    </div>

    <nav class="az-portal-app-grid" aria-label="VisualAcademy applications">
      <a class="az-portal-app-item" href="/">
        <span class="az-portal-app-icon az-app-icon-home"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#home"></use></svg></span>
        <span>Public site</span>
      </a>
      <a class="az-portal-app-item" href="/dashboard">
        <span class="az-portal-app-icon az-app-icon-dashboard"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#dashboard"></use></svg></span>
        <span>Dashboard</span>
      </a>
      <a class="az-portal-app-item" href="/dashboard/resources">
        <span class="az-portal-app-icon az-app-icon-resources"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#resources"></use></svg></span>
        <span>Resources</span>
      </a>
      <a class="az-portal-app-item" href="/courses">
        <span class="az-portal-app-icon az-app-icon-courses"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#courses"></use></svg></span>
        <span>Courses</span>
      </a>
      <a class="az-portal-app-item" href="/docs/">
        <span class="az-portal-app-icon az-app-icon-docs"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#docs"></use></svg></span>
        <span>Documentation</span>
      </a>
      <a class="az-portal-app-item" href="/docs/private/">
        <span class="az-portal-app-icon az-app-icon-protected"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#shield"></use></svg></span>
        <span>Protected docs</span>
      </a>
      <a class="az-portal-app-item" href="/Identity/Account/Manage">
        <span class="az-portal-app-icon az-app-icon-account"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#account"></use></svg></span>
        <span>Account</span>
      </a>
      <a class="az-portal-app-item" href="/products">
        <span class="az-portal-app-icon az-app-icon-products"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#products"></use></svg></span>
        <span>Products</span>
      </a>
      <a class="az-portal-app-item" href="/pricing">
        <span class="az-portal-app-icon az-app-icon-pricing"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#pricing"></use></svg></span>
        <span>Pricing</span>
      </a>
      <a class="az-portal-app-item" href="/Articles"><span class="az-portal-app-icon az-app-icon-docs"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#docs"></use></svg></span><span>Articles</span></a>
      <a class="az-portal-app-item" href="/StandardReports"><span class="az-portal-app-icon az-app-icon-resources"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#resources"></use></svg></span><span>Reports</span></a>
      <a class="az-portal-app-item" href="/aspnetcore-roadmap/index.html"><span class="az-portal-app-icon az-app-icon-courses"><svg aria-hidden="true"><use href="/images/dashboard-icons.svg#courses"></use></svg></span><span>Course roadmap</span></a>
    </nav>

    <div class="az-portal-app-menu-divider"></div>
    <div class="az-portal-app-quick-links">
      <a href="/dashboard/resources">Browse resources <span aria-hidden="true">→</span></a>
      <a href="/courses/aspnet-core">Browse courses <span aria-hidden="true">→</span></a>
      <a href="/docs/getting-started/site-structure">Getting started <span aria-hidden="true">→</span></a>
      <a href="/Identity/Account/Manage">Profile and account <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <div class="az-portal-frame">
    <aside id="portalSidebar" class="az-portal-sidebar">
      <div class="az-portal-sidebar-tools" role="group" aria-label="Navigation tools">
        <button id="dashboardNavSearchToggle" class="az-portal-sidebar-tool" type="button"
                aria-label="Search menus" title="Search menus"
                aria-controls="dashboardNavSearchPanel" aria-expanded="false">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.6" cy="8.6" r="5.5"/><path d="m13 13 4.4 4.4"/></svg>
          <span>Search</span>
        </button>
        <button id="dashboardNavCollapseAll" class="az-portal-sidebar-tool" type="button"
                aria-label="Collapse all menu groups" title="Collapse all menu groups">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 15.8h14M3 4.2h14m-11 8.3 4-4 4 4"/></svg>
          <span>Collapse All</span>
        </button>
      </div>
      <div class="az-portal-sidebar-scroll">
        @await Html.PartialAsync("~/Pages/Shared/_AzDashboardNavigation.cshtml", dashboardNavigation)
      </div>
      <nav class="az-portal-sidebar-fixed-links" aria-label="Quick shortcuts">
        <a href="/dashboard" class="az-portal-sidebar-fixed-link az-is-hawaso" title="Hawaso" aria-label="Hawaso">
          <span class="az-portal-sidebar-fixed-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><use href="/images/dashboard-icons.svg#webapp"></use></svg></span>
          <span class="az-portal-sidebar-fixed-text">Dashboard</span>
        </a>
        <a href="/Articles" class="az-portal-sidebar-fixed-link az-is-dotnetnote" title="DotNetNote" aria-label="DotNetNote">
          <span class="az-portal-sidebar-fixed-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><use href="/images/dashboard-icons.svg#devops"></use></svg></span>
          <span class="az-portal-sidebar-fixed-text">Articles</span>
        </a>
        <a href="/" class="az-portal-sidebar-fixed-link az-is-visualacademy" title="VisualAcademy" aria-label="VisualAcademy">
          <span class="az-portal-sidebar-fixed-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><use href="/images/dashboard-icons.svg#wireframe"></use></svg></span>
          <span class="az-portal-sidebar-fixed-text">VisualAcademy</span>
        </a>
      </nav>
      <button id="sidebarFooterToggle" class="az-portal-sidebar-footer-toggle" type="button" aria-label="Collapse navigation" title="Collapse navigation">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.4 4.8 7.2 10l5.2 5.2" /></svg>
      </button>
    </aside>

    <div id="dashboardNavFlyout"
         class="az-dashboard-nav-flyout"
         aria-hidden="true"
         aria-label="Dashboard submenu">
      <div id="dashboardNavFlyoutContent" class="az-dashboard-nav-flyout-content"></div>
    </div>

    <section id="dashboardNavSearchPanel" class="az-dashboard-nav-search-panel" hidden
             role="dialog" aria-label="Search dashboard menus">
      <div class="az-dashboard-nav-search-title">
        <strong>Search menus</strong>
        <button type="button" id="dashboardNavSearchClose" aria-label="Close menu search" title="Close">×</button>
      </div>
      <label class="az-dashboard-nav-search-label" for="dashboardNavSearchInput">Find a menu</label>
      <input id="dashboardNavSearchInput" type="search" autocomplete="off" placeholder="Search navigation..." />
      <div id="dashboardNavSearchResults" class="az-dashboard-nav-search-results" role="status" aria-live="polite"></div>
    </section>

    <main class="az-portal-content">
      <div class="az-va-dashboard-blazor"><component type="typeof(App)" render-mode="ServerPrerendered" /></div>
    </main>
  </div>

  <div id="blazor-error-ui">
    <environment include="Staging,Production">An error has occurred. Reload the page to continue.</environment>
    <environment include="Development">An unhandled exception has occurred. See browser dev tools for details.</environment>
    <a href="" class="reload">Reload</a><a class="dismiss">🗙</a>
  </div>
  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/azunt-dashboard.js" asp-append-version="true"></script>
  <script src="_framework/blazor.server.js"></script>
</body>
</html>
